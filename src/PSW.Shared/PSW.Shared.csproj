<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>PSW.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <!-- Overrides the vulnerable 8.x pulled in transitively by Microsoft.AspNetCore.Mvc 2.3.x (via DataProtection);
         also lifts System.Security.Cryptography.Pkcs to the same patched version -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <!-- Overrides vulnerable 2.3.11 pulled in transitively by Microsoft.AspNetCore.Mvc 2.3.14 (GHSA-6527-9fp8-r4x6) -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
  </ItemGroup>

</Project>
